---
import styles from '@css/ui/TitleBar.module.css'
import SearchIcon from '@/icons/search.svg'
import HomeIcon from '@/icons/home.svg'
import BinocularsIcon from '@/icons/binoculars.svg'
import ArrowDownCircleIcon from '@/icons/arrow-down-clrcle.svg'
import BellIcon from '@/icons/bell.svg'
---
<header class={styles.titleBar}>
  <nav class={styles.menuLeft}>
    <div>logo</div>
    <a href=""><HomeIcon width="30" height="30" fill="currentColor" /></a>
    <form action="">
      <div>
        <SearchIcon width="24" height="24" fill="currentColor" />
        <input type="text" placeholder="¿Qué quieres reproducir?" />
        <button type="submit"><BinocularsIcon width="24" height="24" fill="currentColor" /></button>
      </div>
    </form>
  </nav>
  <nav class={styles.menuRight}>
    <button>Descubrir Premium</button>
    <a href="#" class={styles.installApp}><ArrowDownCircleIcon width="24" height="24" fill="none" />Instalar app</a>
    <a href="#"><BellIcon width="16" height="16" fill="currentColor" /></a>
    <div class={styles.auth}>
      <a href="#" class={styles.number}>1</a>
      <a href="#" class={styles.perfil}>P</a>
    </div>
  </nav>
</header>