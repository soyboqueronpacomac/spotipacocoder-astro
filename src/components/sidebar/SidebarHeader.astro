---
import styles from "@/css/components/sidebar/SidebarHeader.module.css";
import LayoutSidebarLeftCollapseIcon from '@/icons/layout-sidebar-left-collapse.svg';
import PlusIcon from '@/icons/plus.svg';
import ArrowDiagonalIcon from '@/icons/arrow-diagonal.svg';
---

<header class={styles.sidebarHeader}>
  <nav>
    <button type="button" id="sidebar-toggle" aria-label="Contraer biblioteca" aria-expanded="true">
      <LayoutSidebarLeftCollapseIcon />
    </button>
    <h3>Tu biblioteca</h3>
  
  </nav>
  <nav>
    <span> <PlusIcon /></span>
    <ArrowDiagonalIcon />
  </nav>
</header>

<script>
  const toggle = document.querySelector('#sidebar-toggle')
  toggle?.addEventListener('click', () => {
    const collapsed = document.body.dataset.sidebar === 'collapsed'
    document.body.dataset.sidebar = collapsed ? 'expanded' : 'collapsed'
    toggle.setAttribute('aria-expanded', String(collapsed))
    toggle.setAttribute('aria-label', collapsed ? 'Contraer biblioteca' : 'Expandir biblioteca')
  })
</script>
